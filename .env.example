# CTMS Local Development Environment Variables

# PostgreSQL + TimescaleDB Configuration
POSTGRES_USER=ctms_dev
POSTGRES_PASSWORD=ctms_dev_password_change_in_prod
POSTGRES_DB=ctms_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://ctms_dev:ctms_dev_password_change_in_prod@localhost:5432/ctms_db

# Redis 7 Configuration
REDIS_PASSWORD=redis_local_secret_pass
REDIS_PORT=6379
REDIS_URL=redis://:redis_local_secret_pass@localhost:6379/0

# Dgraph Knowledge Graph (Standalone)
DGRAPH_HTTP_PORT=8080
DGRAPH_GRPC_PORT=9080
DGRAPH_URL=http://localhost:8080

# Mock Zoho Gateway Service
MOCK_ZOHO_PORT=8089
MOCK_ZOHO_URL=http://localhost:8089
ZOHO_ORGANIZATION_ID=zoho_org_apex_mock_2026
ZOHO_CLIENT_ID=mock_client_id
ZOHO_CLIENT_SECRET=mock_client_secret

# Security & Encryption Keys
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_minimum_32_bytes_long
API_KEY_SALT=dev_insecure_salt_for_api_key_hashing_change_in_prod
ANDROID_ROOM_SQLCIPHER_PASSPHRASE=dev_local_sqlite_passphrase_32_chars
